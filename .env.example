# Copy this file to .env and fill in real values. Never commit .env.
#
# Media storage/delivery (Cloudinary) — required for the admin panel's
# image/reel uploads. Create a free account at https://cloudinary.com,
# then copy these three values from your dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Signs the admin-panel auth cookie. Set this to a long random string —
# anyone who knows it can forge an admin session.
ADMIN_SECRET=
